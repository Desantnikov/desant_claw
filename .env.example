# Copy this file to .env and fill in real values. Do NOT commit .env.
# Placeholders only below.

# Address treated as an internal sender
INTERNAL_EMAIL_ADDRESS=
# OpenAI API key used by the LLM agents
OPENAI_API_KEY=
# Model name passed to the OpenAI-backed agents (e.g. a chat-capable model)
DEFAULT_MODEL=

# POSTGRES
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app_db

# QDRANT
QDRANT_HOST=localhost
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true
QDRANT_CLIENT_TIMEOUT=60
